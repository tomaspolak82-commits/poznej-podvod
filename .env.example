# Copy this file to .env and fill in real values. Never commit .env.
# FTP credentials for Subreg hosting (used by scripts/deploy.mjs).
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Must be exactly /poznej-podvod.menestarosti.cz or start with /poznej-podvod.menestarosti.cz/
FTP_REMOTE_DIR=/poznej-podvod.menestarosti.cz
