# Copy this file to .env and fill in real values. Never commit .env.
# FTP credentials for Subreg hosting (used by scripts/deploy.mjs).
#
# Use the separate FTP account of the subdomain poznej-podvod.menestarosti.cz,
# not the main hosting account. Its root (/) is the empty subdomain folder,
# so the main WordPress site is out of reach.
FTP_HOST=hosting.subreg.cz
FTP_USER=
FTP_PASSWORD=
# "/" = root of the subdomain FTP account.
# Also allowed: /poznej-podvod.menestarosti.cz or /poznej-podvod.menestarosti.cz/... (main account).
# Must never contain "..". The script also stops if the folder contains WordPress files.
FTP_REMOTE_DIR=/
